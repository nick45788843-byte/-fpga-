# KEY3当前用于重新读取TF卡，后续由业务控制统一路由。
set_pin_assignment { key3 } { LOCATION = B1; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
# A J1-31/UART_TX/F14 -> serial screen RX; independent of onboard CH340.
set_pin_assignment { uart_tx } { LOCATION = F14; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; PACKREG = OFF; }

# 用户Flash，独立于固件Flash，配置区由控制器限制。
set_pin_assignment { uart_rx } { LOCATION = G14; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; PACKREG = OFF; }
